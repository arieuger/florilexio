; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[Fmod]

General/banks_path="res://assets/sound/FMOD/sounds/Build/Desktop"

[application]

config/name="Florilexio"
run/main_scene="res://ui/start_menu/start_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*uid://by2ku53r40rl2"
InventoryManager="*res://scripts/inventory/inventory_manager.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
DialogueBalloonCoordinator="*uid://cpfd6edlan4so"
FmodManager="*uid://cds10pm7hwn3p"
SoundManager="*uid://cvtendwncqa75"
FinalBouquetCompositionCalculator="*res://scripts/autoload/final_bouquet_composition_calculator.gd"

[dialogue_manager]

runtime/balloon_path="res://ui/dialogue/npc_balloon.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/fmod/plugin.cfg")

[global_group]

player=""

