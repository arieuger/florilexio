[sub_resource type="Resource" id="Resource_3s3r2"]
script = ExtResource("1_5j2b2")
id = &"formal_description"
knowledge_type = 1
text = "As flores son de cor malva, rosa ou púrpura. Son solitarias na punta da rama. Cáliz con 3 pezas libres, elípticas e 5 sépalos triangulares. Corola con 5 pétalos libres, con nervios máis escuros, en xeral bífidos.  Estames numerosos.

Follas palminervias, dentadas ou aserradas.

O froito é unha cápsula formada por varios mericarpos, de forma arriñonada, de cor parda.
"
metadata/_custom_type_script = "uid://doq0kbgt7al22"

